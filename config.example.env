# ClipBridge 설정 예시.
# 복사해서 쓴다:  mkdir -p ~/.config/clipbridge && cp config.example.env ~/.config/clipbridge/clipbridge.env
# 맥의 clipd(server/clipd.py)와 cli/ 의 모든 명령이 이 파일을 읽는다.
# 폰 앱은 빌드할 때 같은 값을 넣는다(android/clipbridge.properties.example 참고, 또는 이 파일을 source 한 채로 빌드).

# 맥의 Tailscale 주소(IP 또는 MagicDNS 이름). `tailscale ip -4` 로 확인한다.
CLIPBRIDGE_MAC_HOST=
# 폰의 Tailscale 주소. Tailscale 앱의 기기 목록에서 확인한다.
CLIPBRIDGE_PHONE_HOST=

# 맥과 폰이 나눠 갖는 비밀 토큰. 예: openssl rand -hex 24
# 비어 있으면 clipd 는 시작하지 않는다.
CLIPBRIDGE_TOKEN=

# 폰에서 보낸 파일이 떨어지는 맥 폴더 (기본: ~/ClipBridge-inbox)
# Desktop·Downloads·Documents 는 macOS 보호 폴더라, launchd 로 띄운 python 이 못 쓸 수 있다(전체 디스크 접근 권한 필요).
# CLIPBRIDGE_INBOX="$HOME/ClipBridge-inbox"

# clipd 의 로그·알림 통계·필터·자동 동기화 상태가 쌓이는 곳 (기본: ~/.local/state/clipbridge)
# CLIPBRIDGE_STATE_DIR="$HOME/.local/state/clipbridge"

# Android SDK 위치 (adb 를 찾는 데 쓴다. 기본: ~/Library/Android/sdk)
# ANDROID_SDK_ROOT="$HOME/Library/Android/sdk"

# 빌드용 JDK 21 (clipbridge-deploy 가 쓴다. 비우면 시스템 JAVA_HOME)
# JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
